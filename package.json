{
  "name": "reservation-bot",
  "version": "1.0.0",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start:api": "node ./dist/apps/api/main.js",
    "start:api:dev": "nest start --debug --watch --sourceRoot ./src/apps/api --entryFile ./apps/api/main",
    "start:bot": "node ./dist/apps/bot/main.js",
    "start:bot:dev": "nest start --debug --watch --sourceRoot ./src/apps/bot --entryFile ./apps/bot/main",
    "start:cron": "node --max-old-space-size=16384 ./dist/apps/cron/main.js",
    "start:cron:dev": "nest start --debug --watch --sourceRoot ./src/apps/cron --entryFile ./apps/cron/main",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "test": "npm run test:unit & npm run test:integration",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json --detectOpenHandles",
    "test:e2e:seq": "jest --runInBand --config ./test/jest-e2e.json --detectOpenHandles",
    "test:integration": "jest --runInBand --config ./src/common/tests/jest-integration.json",
    "test:unit": "jest --config ./src/common/tests/jest-unit.json",
    "lint": "gts lint",
    "fix": "gts fix"
  },
  "dependencies": {
    "@nest-lab/or-guard": "^2.4.1",
    "@nestjs/common": "^10.3.8",
    "@nestjs/config": "^3.2.2",
    "@nestjs/core": "^10.3.8",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.3.8",
    "@nestjs/schedule": "^6.0.0",
    "@nestjs/swagger": "^7.3.1",
    "@nestjs/throttler": "^5.1.2",
    "@nestjs/websockets": "^10.3.8",
    "axios": "^1.7.2",
    "base64url": "^3.0.1",
    "bluebird": "^3.7.2",
    "body-parser": "^1.20.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.3.1",
    "express": "^4.21.0",
    "googleapis": "^162.0.0",
    "grammy": "^1.28.0",
    "helmet": "^8.0.0",
    "http-terminator": "^3.2.0",
    "nest-winston": "^1.9.7",
    "nestjs-cls": "^4.3.0",
    "nestjs-graceful-shutdown": "^1.0.1",
    "nestjs-paginate": "8.6.1",
    "object-hash": "^3.0.0",
    "pg": "^8.12.0",
    "qs": "^6.13.0",
    "reflect-metadata": "^0.1.13",
    "request-ip": "^3.3.0",
    "rxjs": "^7.2.0",
    "socket.io": "^4.7.5",
    "winston": "^3.14.2"
  },
  "devDependencies": {
    "@faker-js/faker": "^8.4.1",
    "@nestjs/cli": "^10.3.2",
    "@nestjs/schematics": "^10.1.1",
    "@nestjs/testing": "^10.3.8",
    "@swc/cli": "0.4.1-nightly.20240914",
    "@swc/core": "^1.7.26",
    "@swc/jest": "^0.2.36",
    "@types/bluebird": "^3.5.42",
    "@types/cookie-parser": "^1.4.5",
    "@types/express": "^4.17.13",
    "@types/jest": "29.2.4",
    "@types/node": "20.12.7",
    "@types/object-hash": "^3.0.6",
    "@types/request-ip": "^0.0.40",
    "@types/supertest": "^2.0.11",
    "@typescript-eslint/eslint-plugin": "^5.0.0",
    "@typescript-eslint/parser": "^5.0.0",
    "eslint": "^8.0.1",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-prettier": "^4.0.0",
    "gts": "^5.3.1",
    "jest": "29.7.0",
    "prettier": "^2.3.2",
    "source-map-support": "^0.5.20",
    "supertest": "^6.1.3",
    "ts-jest": "29.0.3",
    "ts-loader": "^9.2.3",
    "ts-node": "^10.0.0",
    "tsconfig-paths": "4.1.1",
    "typescript": "^5.4.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/$1"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "volta": {
    "node": "20.17.0",
    "yarn": "1.22.22"
  }
}